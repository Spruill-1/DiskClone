#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DC_VERSION_MAJOR,DC_VERSION_MINOR,DC_VERSION_PATCH,0
 PRODUCTVERSION DC_VERSION_MAJOR,DC_VERSION_MINOR,DC_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "David Spruill"
            VALUE "FileDescription", "diskclone - Windows disk cloning utility"
            VALUE "FileVersion", DC_VERSION_STRING_A
            VALUE "InternalName", "diskclone"
            VALUE "OriginalFilename", "diskclone.exe"
            VALUE "ProductName", "DiskClone"
            VALUE "ProductVersion", DC_VERSION_STRING_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
